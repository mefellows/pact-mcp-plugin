{
  "consumer": {
    "name": "weather-agent"
  },
  "interactions": [
    {
      "description": "a request for the Melbourne weather",
      "pending": false,
      "pluginConfiguration": {
        "mcp": {
          "operation": "tools/call",
          "server": {
            "transport": "stdio"
          }
        }
      },
      "request": {
        "contents": {
          "content": {
            "arguments": {
              "city": "Melbourne"
            },
            "name": "get_weather"
          },
          "contentType": "application/mcp+json",
          "contentTypeHint": "TEXT",
          "encoded": false
        }
      },
      "response": [
        {
          "contents": {
            "content": {
              "content": [
                {
                  "text": "Sunny, 22C",
                  "type": "text"
                }
              ],
              "isError": false
            },
            "contentType": "application/mcp+json",
            "contentTypeHint": "TEXT",
            "encoded": false
          },
          "matchingRules": {
            "body": {
              "$.content[0].text": {
                "combine": "AND",
                "matchers": [
                  {
                    "match": "type"
                  }
                ]
              }
            }
          }
        }
      ],
      "type": "Synchronous/Messages"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.1"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "4.0"
    },
    "plugins": [
      {
        "configuration": {},
        "name": "mcp",
        "version": "0.1.0"
      }
    ]
  },
  "provider": {
    "name": "weather-mcp"
  }
}